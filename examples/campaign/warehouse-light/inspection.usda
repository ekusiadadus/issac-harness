#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [@scene.usda@, @../families/capture/studio.usda@]
    upAxis = "Z"
)

over "World"
{
    def Material "Plywood" (
        prepend references = @../../inspection/geometry.usdc@</World/Materials/Wood>
    )
    {
    }
    over "Surface"
    {
        rel material:binding = </World/Plywood>
        texCoord2f[] primvars:st = [(0, 0), (1.68, 0), (1.68, 1.2), (0, 1.2)] (
            interpolation = "vertex"
        )
    }
}

over "_HarnessStudio"
{
    over "Fill" {
        float inputs:intensity = 0
    }
}
