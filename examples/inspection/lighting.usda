#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Lights"
    {
        def RectLight "OverheadSoftbox"
        {
            color3f inputs:color = (1, 0.96, 0.91)
            float inputs:height = 0.75
            float inputs:intensity = 171.96837
            float inputs:width = 1.1
            float3 xformOp:rotateXYZ = (0, 0, 0)
            double3 xformOp:translate = (-0.4, -0.1, 2.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def RectLight "SteelEdge"
        {
            color3f inputs:color = (0.79, 0.88, 1)
            float inputs:height = 1.1
            float inputs:intensity = 122.18805
            float inputs:width = 0.35
            float3 xformOp:rotateXYZ = (0, 0, 0)
            double3 xformOp:translate = (0.95, 0.35, 2.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def SphereLight "FrontFill"
        {
            color3f inputs:color = (1, 0.93, 0.84)
            float inputs:intensity = 42.992092
            float inputs:radius = 0.16
            double3 xformOp:translate = (0, -1.1, 1.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def RectLight "LabelSoftbox"
        {
            color3f inputs:color = (1, 0.98, 0.95)
            float inputs:height = 0.46
            float inputs:intensity = 282.8427
            float inputs:width = 0.72
            matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.44298967110303084, 0.8965267153275625, 0), (0, -0.8965267153275625, 0.44298967110303084, 0), (0.35999999999999993, -0.9499999999999997, 1.4199999999999997, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def DomeLight "Ambient"
        {
            color3f inputs:color = (0.89, 0.93, 1)
            float inputs:intensity = 2.0364676
            asset inputs:texture:file = @./lighting/empty_warehouse_01_1k.hdr@
            token inputs:texture:format = "latlong"
        }
    }
}
